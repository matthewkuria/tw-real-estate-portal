# Copy to backend/.env for local development. In production, set these as
# real environment variables instead.

# Never True in production.
DJANGO_DEBUG=False

# Required. Signs sessions, JWTs and password reset links. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this API is served on, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=

# Next.js app; password reset emails link here.
FRONTEND_URL=http://localhost:3000

# Sender address for outgoing email.
DEFAULT_FROM_EMAIL=no-reply@example.com

# SMTP. Leave EMAIL_HOST empty to print emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# WebSockets. Comma-separated browser origins allowed to connect;
# defaults to FRONTEND_URL.
WEBSOCKET_ALLOWED_ORIGINS=

# Redis for WebSocket events, e.g. redis://localhost:6379/0. Required when
# running more than one server process; leave empty for local development.
REDIS_URL=

# Comma-separated browser origins allowed to call the API (portal and
# public website), e.g. https://portal.example.com,https://www.example.com.
# Defaults to FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# Uploaded gallery images. In production serve MEDIA_ROOT from the web
# server or a CDN and set MEDIA_URL to its public URL.
MEDIA_URL=/media/
MEDIA_ROOT=
GALLERY_MAX_UPLOAD_MB=10
