# Copy to backend/.env for local development. In production, set these as
# real environment variables instead.

# Never True in production.
DJANGO_DEBUG=False

# Required. Signs sessions, JWTs and password reset links. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this API is served on, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=

# Next.js app; password reset emails link here.
FRONTEND_URL=http://localhost:3000

# Sender address for outgoing email.
DEFAULT_FROM_EMAIL=no-reply@example.com

# SMTP. Leave EMAIL_HOST empty to print emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# WebSockets. Comma-separated browser origins allowed to connect;
# defaults to FRONTEND_URL.
WEBSOCKET_ALLOWED_ORIGINS=

# Redis for WebSocket events, e.g. redis://localhost:6379/0. Required when
# running more than one server process; leave empty for local development.
REDIS_URL=

# Comma-separated browser origins allowed to call the API (portal and
# public website), e.g. https://portal.example.com,https://www.example.com.
# Defaults to FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# Database, e.g. postgres://user:password@host:5432/dbname. Leave empty to
# use SQLite (backend/db.sqlite3). Set DB_CONN_MAX_AGE (seconds) only if
# you know you want persistent connections.
DATABASE_URL=
DB_CONN_MAX_AGE=0

# Uploaded images (gallery, ads, rentals, listings) on local disk.
# MEDIA_ROOT can point at a mounted persistent disk, e.g. /var/data/media.
# SERVE_MEDIA lets Django serve them in production; defaults to DJANGO_DEBUG.
MEDIA_URL=/media/
MEDIA_ROOT=
SERVE_MEDIA=
GALLERY_MAX_UPLOAD_MB=10

# Or store uploads in S3-compatible object storage (AWS S3, Cloudflare R2,
# Supabase Storage). Setting the bucket name switches it on; the other
# storage values above are then ignored. The bucket must be public.
# - R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region
#   auto, custom domain the bucket's public hostname.
# - Supabase: endpoint https://<ref>.supabase.co/storage/v1/s3, region the
#   project's region, addressing style path, custom domain
#   <ref>.supabase.co/storage/v1/object/public/<bucket>.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_ADDRESSING_STYLE=
AWS_S3_CUSTOM_DOMAIN=

# Public URL of this API. One-click unsubscribe links in newsletters
# point here, so it must be reachable from the internet.
API_BASE_URL=http://localhost:8000

# Name shown in newsletter emails.
SITE_NAME=Real Estate Portal
